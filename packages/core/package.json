{
  "name": "@augrid/core",
  "version": "0.7.1",
  "description": "AuGrid \u2014 a free, high-performance data grid. Framework-agnostic core.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "datagrid",
    "grid",
    "table",
    "virtual-scroll",
    "pivot",
    "web-component"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/methodify/augrid.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/methodify/augrid",
  "bugs": "https://github.com/methodify/augrid/issues"
}

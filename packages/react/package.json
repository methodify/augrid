  },
  "peerDependencies": {
    "@augrid/core": ">=0.2.0 <0.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@augrid/core": "workspace:*",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/methodify/augrid.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/methodify/augrid",
  "bugs": "https://github.com/methodify/augrid/issues"

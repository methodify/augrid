{
  "name": "@augrid/react",
  "version": "0.2.0",
  "description": "React wrapper for AuGrid.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
